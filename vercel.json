{
  "cleanUrls": true,
  "framework": null,
  "installCommand": "echo 'Skipping install step'",
  "buildCommand": "mkdir -p dist && cp -r build/web/. dist/ && test -f dist/main.dart.js && test -f dist/index.html && echo 'Static files ready in dist/'",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
