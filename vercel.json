{
  "cleanUrls": true,
  "framework": null,
  "installCommand": "echo 'Skipping install step'",
  "buildCommand": "rm -rf web && cp -r dist/. web/ && test -f web/main.dart.js && echo 'Deployed static files copied to web/'",
  "outputDirectory": "web",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
