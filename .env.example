# AeroFit — use dart-define at run/build time (see docs/FIREBASE_SETUP.md)
# Firebase keys live in lib/firebase_options.dart (flutterfire configure)

# Master admin portal (optional compile-time email gate)
# MASTER_ADMIN_EMAIL=admin@yourgym.com

# One-time bootstrap (scripts/setup_master_admin.mjs):
# MASTER_ADMIN_EMAIL=admin@yourgym.com
# MASTER_ADMIN_PASSWORD=your-secure-password
# MASTER_ADMIN_NAME=Platform Admin

FOOD_VISION_API_URL=http://localhost:8000/api/analyze-food
DISPLAY_NAME=Minusha
DAILY_CALORIE_GOAL=2000

# Gemini API key for meal-photo analysis (required for that feature to work).
# Get one at https://aistudio.google.com/apikey — never commit a real value.
# GEMINI_API_KEY=your-gemini-api-key
